# Veřejná konfigurace frontendu. Pro samostatný náhled ponechte prázdné.
# Vyplňte až po nasazení vlastního autentizovaného backendu.
# Příklad: https://api.example.com/api nebo /api pro stejný origin.
# Tato adresa je veřejná; nesmí obsahovat heslo, token ani tajné query parametry.
VITE_API_BASE_URL=

# Tajemství nastavujte pouze v prostředí skutečného backendu, ne v tomto SPA.
# server-reference/providers.ts je migrační podklad, nikoli nasazené API.
# BOOKING_CLIENT_ID=
# BOOKING_CLIENT_SECRET=
# AIRBNB_ACCESS_TOKEN=
# OPENAI_API_KEY=                  # volitelné, pouze pro AI na backendu

# Původní názvy se z bezpečnostních důvodů nepoužívají:
# VITE_BOOKING_CLIENT_ID
# VITE_BOOKING_CLIENT_SECRET
# VITE_AIRBNB_ACCESS_TOKEN
# VITE_AIRBNB_CLIENT_ID
# VITE_OPENAI_API_KEY
# Vite smí do prohlížeče předat pouze VITE_API_BASE_URL.
