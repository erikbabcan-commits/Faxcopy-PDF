{
  "name": "presspilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, dependency-free browser client for the PressPilot pilot API",
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build.mjs",
