FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app/backend
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 scanner \
    && useradd --uid 10001 --gid 10001 --no-create-home scanner
# No database credentials, user documents volume, or app database modules are copied.
COPY backend/app/__init__.py backend/app/schemas.py backend/app/inspector.py backend/app/scan_process.py backend/app/scanning.py backend/app/config.py backend/app/scanner_service.py backend/app/middleware.py ./app/
USER 10001:10001
EXPOSE 9000
CMD ["python", "-m", "uvicorn", "app.scanner_service:app", "--host", "0.0.0.0", "--port", "9000", "--no-proxy-headers", "--no-access-log", "--limit-concurrency", "4"]
