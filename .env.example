# Loopback-only Docker pilot. Generate random secrets with python scripts/make_env.py.
# Do not commit .env. Never add secrets to browser source or VITE_ variables.
APP_ENV=pilot
APP_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
MIGRATION_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_PASSWORD
RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
SCANNER_TOKEN=REPLACE_WITH_RANDOM_SCANNER_TOKEN
MAX_UPLOAD_MB=25
SCAN_TIMEOUT_SECONDS=45
# Optional Ollama base URL, operator-controlled. Leave blank for rules-only fallback.
LLM_BASE_URL=
LLM_MODEL=
